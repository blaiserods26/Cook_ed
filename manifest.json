{
    "manifest_version": 3,
    "name": "Cook_ed",
    "description": "Track consent, see cookies by site, and auto-delete unused cookies.",
    "version": "0.1.0",
    "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "browsingData",
    "history",
    "alarms"
    ],
    "host_permissions": [
    "<all_urls>"
    ],
    "background": {
    "service_worker": "service_worker.js"
    },
    "action": {
    "default_title": "Cookie Gardener",
    "default_popup": "popup/popup.html"
    },
    "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
    },
    "options_page": "options/options.html",
    "content_scripts": [
    {
    "matches": ["<all_urls>"],
    "js": ["content/consent-watcher.js"],
    "run_at": "document_idle"
    }
    ]
    }